# Runtime
NODE_ENV=development
PORT=3000

# Required in production. Comma-separate multiple browser origins.
CORS_ORIGIN=http://localhost:5173

# Required in production: Neon PostgreSQL connection
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_SSL=true

# Required in production: RS256 JWT signing and verification keys.
# Store multiline keys with newline characters escaped as \n.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Required in production when file storage is enabled.
S3_AWS_ACCESS_KEY_ID=
S3_AWS_SECRET_ACCESS_KEY=
S3_AWS_BUCKET_REGION=
S3_AWS_API_URL=
S3_AWS_PRIVATE_BUCKET_NAME=
AWS_S3_BUCKET_PUBLIC_NAME=

# Optional: enables the AI chatbot.
GEMINI_API_KEY=

# Optional: defaults are 100 requests per 60 seconds per client IP.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Optional: Swagger is enabled outside production and disabled in production.
SWAGGER_ENABLED=false
